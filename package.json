{
  "name": "appointment-reminders",
  "version": "1.0.0",
  "description": "Appointment reminders with reply handling on the Sent API, built with Next.js and TypeScript",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "setup:templates": "tsx --env-file=.env scripts/setup.ts templates",
    "setup:webhook": "tsx --env-file=.env scripts/setup.ts webhook",
    "lint": "biome lint .",
    "lint:prose": "tsx scripts/lint-prose.ts",
    "audit:deps": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run lint:prose && npm run audit:deps"
  },
  "dependencies": {
    "@sentdm/sentdm": "^0.55.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
