{
  "name": "sent-appointment-reminders",
  "version": "1.0.0",
  "description": "Appointment reminders with reply handling on the Sent API",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "setup:templates": "tsx --env-file=.env scripts/setup.ts templates",
    "setup:webhook": "tsx --env-file=.env scripts/setup.ts webhook"
  },
  "dependencies": {
    "@sentdm/sentdm": "^0.55.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
